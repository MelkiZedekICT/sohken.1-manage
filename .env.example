# Local app defaults do not need this file. Keep real values out of Git.

# Optional billing service settings. Configure these only on the Sohken server.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_PLAN_ID=
RAZORPAY_WEBHOOK_SECRET=

# Server configuration
# Required when the server is exposed outside this computer.
PORT=7860
SOHKEN_HOST=0.0.0.0
SOHKEN_ALLOW_REMOTE=true
SOHKEN_PUBLIC_ORIGIN=https://sohken.example
SOHKEN_SECURE_COOKIES=true

# Security configuration
# Set true only when a trusted reverse proxy sets X-Real-IP.
SOHKEN_TRUST_PROXY=false
# Maximum requests per hour per IP (defaults to 1000)
SOHKEN_RATE_LIMIT_HOUR=1000
