{
  "manifest_version": 3,
  "name": "Sohken Security Companion",
  "description": "On-demand, local checks for suspicious instructions and exposed secrets. Optional pairing with your local Sohken engine.",
  "version": "0.1.0",
  "icons": {"16":"icon-16.png","32":"icon-32.png","48":"icon-48.png","128":"icon-128.png"},
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://127.0.0.1/*"],
  "action": {"default_popup": "popup.html", "default_title": "Sohken · inspect before you act"},
  "content_security_policy": {"extension_pages": "script-src 'self'; object-src 'none'; base-uri 'none'; connect-src http://127.0.0.1:4317"}
}
